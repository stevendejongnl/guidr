{
  "name": "@guidr/web-app",
  "version": "1.22.8",
  "type": "module",
  "description": "Guidr web application - Step-by-step guide execution SPA",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "web-test-runner --config web-test-runner.config.mjs",
    "test:watch": "web-test-runner --config web-test-runner.config.mjs --watch",
    "test:coverage": "web-test-runner --config web-test-runner.config.mjs --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@guidr/shared": "*",
    "@lit/context": "^1.1.6",
    "@sentry/browser": "^9.0.0",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "eslint": "^9.38.0",
    "ts-patch": "^3.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-transform-paths": "^3.5.5",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.6"
  }
}
