#!/usr/bin/env bash
set -e

echo "Running pre-commit checks..."
echo ""

echo "📱 Checking Mobile (TypeScript + ESLint)..."
npm --prefix mobile run typecheck
npm --prefix mobile run lint
echo "✓ Mobile checks passed"
echo ""

echo "🌐 Checking Web-app (TypeScript + ESLint)..."
npm --prefix web-app run typecheck
npm --prefix web-app run lint
echo "✓ Web-app checks passed"
echo ""

echo "🔧 Checking API (Ruff + Mypy)..."
cd api-server
.venv/bin/ruff check .
.venv/bin/python -m mypy src
cd ..
echo "✓ API checks passed"
echo ""

echo "✓ All pre-commit checks passed!"
