#!/usr/bin/env bash
set -e

echo "Running pre-push checks..."
echo ""

# Security Scanning
echo "🔒 Security: Scanning dependencies..."
./scripts/npm-audit-security.sh . high mobile
./scripts/npm-audit-security.sh . high || true
if [ -f api-server/.venv/bin/pip-audit ]; then
  (cd api-server && .venv/bin/pip install --upgrade pip --quiet)
  PIP_AUDIT_OUTPUT=$((cd api-server && .venv/bin/pip-audit --desc --skip-editable --ignore-vuln GHSA-wj6h-64fc-37mp --ignore-vuln CVE-2026-4539 --ignore-vuln CVE-2026-25645) 2>&1) || {
    echo "$PIP_AUDIT_OUTPUT"
    echo "❌ API security scan failed"
    exit 1
  }
else
  echo "⚠ pip-audit not installed, skipping API security scan"
fi
echo ""

echo "📱 Running Mobile Tests..."
MOBILE_OUTPUT=$(NODE_OPTIONS="--max-old-space-size=8192" npm test --workspace=mobile 2>&1) || {
  echo "$MOBILE_OUTPUT" | grep -E "^(FAIL|●|✕|✗| FAIL | ● )" || echo "$MOBILE_OUTPUT" | tail -30
  echo "❌ Mobile tests failed"
  exit 1
}
echo "$MOBILE_OUTPUT" | grep -E "^Tests:" | tail -1
echo "✓ Mobile tests passed"
echo ""

echo "🔧 Running API Tests..."
API_OUTPUT=$(npm run api:test 2>&1) || {
  echo "$API_OUTPUT" | grep -E "^(FAILED|ERROR|error)" || echo "$API_OUTPUT" | tail -30
  echo "❌ API tests failed"
  exit 1
}
echo "$API_OUTPUT" | grep -E "passed|failed" | tail -1
echo "✓ API tests passed"
echo ""

echo "✓ All pre-push checks passed!"
