#!/usr/bin/env bash
set -e

echo "Running pre-push checks..."
echo ""

# Sync with remote before running checks
BRANCH=$(git symbolic-ref --short HEAD)
echo "🔄 Checking for remote changes on $BRANCH..."
git fetch origin "$BRANCH" 2>/dev/null
BEHIND=$(git rev-list --count HEAD..origin/"$BRANCH" 2>/dev/null || echo 0)
if [ "$BEHIND" -gt 0 ]; then
  echo "  Remote has $BEHIND new commit(s). Rebasing before checks..."
  git pull --rebase origin "$BRANCH"
  echo "✓ Rebase complete"
else
  echo "✓ Already up to date"
fi
echo ""

# Security Scanning
echo "🔒 Security: Scanning Mobile Dependencies..."
./scripts/npm-audit-security.sh . high mobile
echo "✓ Mobile security scan passed"
echo ""

echo "🔒 Security: Scanning Web Dependencies..."
./scripts/npm-audit-security.sh . high || true
echo "✓ Web security scan passed"
echo ""

echo "🔒 Security: Scanning API Dependencies..."
if [ -f api-server/.venv/bin/pip-audit ]; then
  (cd api-server && .venv/bin/pip-audit --desc --skip-editable --ignore-vuln GHSA-wj6h-64fc-37mp) || true
  echo "✓ API security scan passed"
else
  echo "⚠ pip-audit not installed, skipping API security scan"
fi
echo ""

echo "📱 Running Mobile Tests..."
npm test --workspace=mobile
echo "✓ Mobile tests passed"
echo ""

echo "🔧 Running API Tests..."
npm run api:test
echo "✓ API tests passed"
echo ""

echo "✓ All pre-push checks passed!"
