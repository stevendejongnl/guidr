#!/usr/bin/env bash
set -e

echo "Running pre-push checks..."
echo ""

# Security Scanning
echo "🔒 Security: Scanning Mobile Dependencies..."
# Note: tar@7.5.2 and diff@8.0.2 in npm CLI are bundled, cannot be overridden (ADR-015)
npm --prefix mobile audit --audit-level=high || {
  echo "⚠ Known issues: tar/diff in npm CLI bundled dependencies (documented in ADR-015)"
  echo "  See: SECURITY.md, README.md, ADR-015"
}
echo "✓ Mobile security scan completed"
echo ""

echo "🔒 Security: Scanning Web Dependencies..."
npm --prefix web-app audit --audit-level=high
echo "✓ Web security scan passed"
echo ""

echo "🔒 Security: Scanning API Dependencies..."
cd api-server
if [ -f .venv/bin/pip-audit ]; then
  .venv/bin/pip-audit --desc --skip-editable --ignore-vuln GHSA-wj6h-64fc-37mp
  echo "✓ API security scan passed"
else
  echo "⚠ pip-audit not installed, skipping API security scan"
fi
cd ..
echo ""

echo "📱 Running Mobile Tests..."
npm --prefix mobile test
echo "✓ Mobile tests passed"
echo ""

echo "🔧 Running API Tests..."
cd api-server
.venv/bin/python -m pytest
cd ..
echo "✓ API tests passed"
echo ""

echo "✓ All pre-push checks passed!"
