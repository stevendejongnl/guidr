git_url("https://git.madebysteven.nl/stevendejong/guidr-certificates.git")
# Gitea requires basic auth in username:token format
git_basic_authorization("stevendejong:#{ENV['GITEA_TOKEN']}")

storage_mode("git")
type("appstore")

app_identifier(["com.guidr"])
username(ENV['APPLE_ID'])
team_id(ENV['APPLE_TEAM_ID'])

# Certificate repo branch
git_branch("main")

# Shallow clone for faster operations
shallow_clone(true)

# Verbose logging for debugging
verbose(true)
