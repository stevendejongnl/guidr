{
  "name": "guidr",
  "version": "1.79.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11.6.0"
  },
  "scripts": {
    "android": "npm run prebuild && react-native run-android",
    "android:watch": "npm run prebuild && node ../scripts/watch-android.js",
    "android:build": "npm run prebuild && react-native build-android",
    "ios": "npm run prebuild && react-native run-ios",
    "ios:build": "npm run prebuild && react-native build-ios",
    "generate-icons": "node ../scripts/generate-icons.js",
    "preandroid": "node ../scripts/copy-config.js",
    "preios": "node ../scripts/copy-config.js",
    "start": "npm run prebuild && react-native start",
    "prebuild": "npm run build --workspace=shared",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint --ext .ts,.tsx src",
    "lint:fix": "eslint --ext .ts,.tsx src --fix",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "prepare": "husky",
    "security:scan": "../scripts/npm-audit-security.sh . high",
    "security:full": "npm audit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/cli-platform-android": "^20.0.2",
    "@react-native/babel-preset": "^0.83.1",
    "@react-native/metro-config": "^0.83.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.7",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "^19.2.4",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@guidr/shared": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@sentry/react-native": "^7.8.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.83.1",
    "react-native-device-info": "^15.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.19.0",
    "react-native-uuid": "^2.0.3",
    "sharp": "^0.34.5",
    "smol-toml": "^1.3.3",
    "typia": "^11.0.3"
  },
  "overrides": {
    "tar": ">=7.5.8",
    "ajv": ">=6.14.0",
    "fast-xml-parser": ">=4.5.4",
    "markdown-it": "12.3.2",
    "undici": "7.18.2",
    "lodash": "4.17.23",
    "lodash-es": "4.17.23"
  }
}
