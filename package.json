{
  "name": "guidr-monorepo",
  "version": "1.23.1",
  "private": true,
  "description": "Guidr monorepo - mobile app, API server, and web app",
  "scripts": {
    "mobile:lint": "cd mobile && npm run lint",
    "mobile:test": "cd mobile && npm test",
    "mobile:typecheck": "cd mobile && npm run typecheck",
    "mobile:android": "cd mobile && npm run android",
    "mobile:ios": "cd mobile && npm run ios",
    "api:test": "cd api-server && .venv/bin/python -m pytest",
    "api:lint": "cd api-server && .venv/bin/ruff check .",
    "api:typecheck": "cd api-server && .venv/bin/python -m mypy src",
    "web:lint": "cd web-app && npm run lint",
    "web:typecheck": "cd web-app && npm run typecheck",
    "web:build": "cd web-app && npm run build",
    "web:dev": "cd web-app && npm run dev",
    "lint": "npm run mobile:lint && npm run web:lint && npm run api:lint",
    "typecheck": "npm run mobile:typecheck && npm run web:typecheck && npm run api:typecheck",
    "test": "npm run mobile:test && npm run api:test",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
