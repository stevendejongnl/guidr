{
  "name": "guidr-monorepo",
  "version": "1.23.1",
  "private": true,
  "description": "Guidr monorepo - mobile app, API server, and web app",
  "workspaces": [
    "shared",
    "mobile",
    "web-app"
  ],
  "scripts": {
    "mobile:lint": "npm --prefix mobile run lint",
    "mobile:test": "npm --prefix mobile test",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:android": "bash scripts/mobile-android-tmux-new.sh",
    "mobile:ios": "npm --prefix mobile run ios",
    "api:test": "cd api-server && uv run pytest",
    "api:lint": "cd api-server && uv run ruff check .",
    "api:typecheck": "cd api-server && uv run mypy src",
    "web:lint": "npm --prefix web-app run lint",
    "web:typecheck": "npm --prefix web-app run typecheck",
    "web:build": "npm --prefix web-app run build",
    "web:dev": "npm --prefix web-app run dev",
    "lint": "npm run mobile:lint && npm run web:lint && npm run api:lint",
    "typecheck": "npm run mobile:typecheck && npm run web:typecheck && npm run api:typecheck",
    "test": "npm run mobile:test && npm run api:test",
    "security:mobile": "./scripts/npm-audit-security.sh ./mobile high",
    "security:web": "npm --prefix web-app audit --audit-level=high",
    "security:api": "cd api-server && .venv/bin/pip-audit --desc --skip-editable --ignore-vuln GHSA-wj6h-64fc-37mp",
    "security:all": "npm run security:mobile && npm run security:web && npm run security:api",
    "security:fix:mobile": "npm --prefix mobile audit fix",
    "security:fix:web": "npm --prefix web-app audit fix",
    "postinstall": "node scripts/setup-sentry-symlink.js",
    "prepare": "node scripts/setup-husky.js"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.3",
    "@semantic-release/npm": "^13.1.3",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.3"
  }
}
