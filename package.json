    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.83.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.19.0",
    "react-native-uuid": "^2.0.3"
  }
